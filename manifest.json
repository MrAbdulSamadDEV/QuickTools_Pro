{
  "manifest_version": 3,
  "name": "NEXA Tools",
  "short_name": "NEXA",
  "version": "7.3.0",
  "description": "A clean monochrome all-in-one browser toolkit with audio boost, display controls, QR, developer and image tools.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "action": {
    "default_title": "QuickTools Pro",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}