{
  "manifest_version": 3,
  "name": "QuickTools Pro",
  "short_name": "QuickTools",
  "version": "3.0.0",
  "description": "Fast browser tools for tabs, URLs, text, notes, and developer tasks.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "downloads"
  ],
  "action": {
    "default_title": "QuickTools Pro",
    "default_popup": "popup.html"
  }
}